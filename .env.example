# Free-tier keys (no card required)
# Groq:            https://console.groq.com/keys
# Google AI Studio: https://aistudio.google.com/apikey
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides. Providers retire model IDs on their own schedule;
# hit GET /available-models (or the Diagnostics button in the UI) to see what
# your key can currently call, then set it here and restart - no code change.
# OSS_MODEL=groq/llama-3.3-70b-versatile
# FRONTIER_MODEL=gemini/gemini-3.6-flash
# JUDGE_MODEL=groq/openai/gpt-oss-20b
