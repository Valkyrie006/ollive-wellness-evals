# Free-tier keys (no card required)
# Groq:            https://console.groq.com/keys
# Google AI Studio: https://aistudio.google.com/apikey
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides. Providers retire model IDs on their own schedule;
# hit GET /available-models (or the Diagnostics button in the UI) to see what
# your key can currently call, then set it here and restart - no code change.
# OSS_MODEL=gemini/gemma-4-26b-a4b-it   # open weights; groq/openai/gpt-oss-20b also works
# FRONTIER_MODEL=gemini/gemini-3.1-flash-lite
# JUDGE_MODEL=groq/qwen/qwen3.8-27b   # keep this in a DIFFERENT family from both agents
