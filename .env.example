# --- required: free tier, no card ---------------------------------------
# Groq:             https://console.groq.com/keys
# Google AI Studio: https://aistudio.google.com/apikey
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- environment ---------------------------------------------------------
# "production" hides upstream error detail behind a request id and disables
# the debug endpoints (/diagnostics, /available-models, /docs).
APP_ENV=development

# --- models --------------------------------------------------------------
# Providers retire model IDs on their own schedule. GET /available-models
# (or the Diagnostics button) shows what your key can currently call.
# The judge must stay in a DIFFERENT model family from both agents, or it
# scores its own family favourably. See docs/DESIGN.md.
# OSS_MODEL=groq/openai/gpt-oss-20b
# FRONTIER_MODEL=gemini/gemini-3.6-flash
# JUDGE_MODEL=groq/qwen/qwen3.8-27b

# --- limits --------------------------------------------------------------
# RATE_LIMIT_REQUESTS=20          # per window, per client; 0 disables
# RATE_LIMIT_WINDOW_SECONDS=60
# MAX_MESSAGE_CHARS=4000
# SESSION_TTL_SECONDS=3600
# MAX_SESSIONS=1000

# --- exposure ------------------------------------------------------------
# ENABLE_DEBUG_ENDPOINTS=false    # defaults off when APP_ENV=production
# CORS_ORIGINS=https://example.com
